# ===================================================================
# REQUIRED SETTINGS
# ===================================================================

# Authentication secret key (REQUIRED)
# Generate with: openssl rand -hex 32 and paste the result below.
# gdluxx refuses to start in production while this is empty or a placeholder.
AUTH_SECRET=

# Set ORIGIN to the exact address you use to reach gdluxx in your browser,
# including http:// or https:// and the port. If it doesn't match,
# you won't be able to log in.

# Default (use for local dev or testing)
ORIGIN=http://localhost:7755

# Accessing from other devices on your network
# ORIGIN=http://192.168.0.10:7755

# Using your own domain (via Caddy, Nginx, Traefik, etc.)
# ORIGIN=https://gdluxx.my-cool-domain.com

# ===================================================================
# TROUBLESHOOTING
# ===================================================================

# Leave these unset unless login is broken

# Only needed if you can't make ORIGIN match your browser's address.
# Forces login cookies to HTTPS-only (true) or allows plain HTTP
# (false). Setting true on an http:// address will break login.
# USE_SECURE_COOKIES=false

# If you see "Cross-site POST form submissions are forbidden", ORIGIN
# does not match the address your browser uses to reach gdluxx. Correct
# ORIGIN above and restart. (Source builds that previously set
# DISABLE_CSRF_CHECK=true must set a correct ORIGIN and rebuild; that
# variable no longer has any effect.)

# ===================================================================
# REVERSE PROXY
# ===================================================================

# Leave UNSET unless gdluxx sits behind a proxy

# gdluxx rate-limits login attempts. By default it trusts NO forwarding header,
# so a directly-exposed instance cannot be tricked by a spoofed/rotated
# X-Forwarded-For into bypassing the limiter: with no trusted header it reads no
# client IP and throttles every login attempt through one shared global bucket,
# fine for a single-user self-host.
#
# Set this ONLY if a reverse proxy (Caddy, Nginx, Traefik, …) sits
# in front of gdluxx and sets a trustworthy client-IP header. Name that header
# here to key the limiter per client IP instead. Do NOT set it on a
# directly-exposed instance, that would re-open the spoofing bypass.
# TRUSTED_PROXY_HEADER=x-forwarded-for

# ===================================================================
# ADVANCED SETTINGS
# You probably don't need to change these!
# Only change these if you need custom configuration
# ===================================================================

# Custom port (default: 7755)
# PORT=7755

# Custom host binding (default: 0.0.0.0 for Docker)
# Use 127.0.0.1 for localhost-only access
# HOST=0.0.0.0

# Custom data directory (default: ./data)
# FILE_STORAGE_PATH=/custom/path/to/data

# gallery-dl policy. Restricted mode is the default: leave this unset or empty,
# or use the exact value "restricted". Set the exact value "unrestricted" to
# allow command-capable gallery-dl options and config settings, and to permit
# config paths outside gdluxx's normally allowed directories. Structural config
# validation and Docker path rewriting still apply. Any other non-empty value is
# treated as Restricted and logs a warning without including the supplied value.
# Recreate the container or restart the process after changing it.
#
# GDLUXX_GDL_POLICY=unrestricted

# Job queue. Jobs beyond the limit wait in a queue and start, oldest first, as
# running jobs finish. Empty or unset values use the defaults; an invalid value
# also uses the default and logs a warning at startup. Recreate the container or
# restart the process after changing them.
#
# Maximum gallery-dl jobs running at once, 1 to 100 (default: 5)
# GDLUXX_MAX_CONCURRENT_JOBS=5
#
# Maximum jobs running at once for the same website, 1 to 100 (default: no limit)
# GDLUXX_MAX_CONCURRENT_JOBS_PER_HOST=1
#
# Seconds to wait between starting two jobs for the same website, 0 to 3600
# (default: no delay)
# GDLUXX_SAME_HOST_START_DELAY_SECONDS=2

# Bare-metal only: gdluxx rejects gallery-dl config paths (base-directory,
# archive, part-directory, cookies, cache.file, etc.) that resolve outside its
# data directory and DOWNLOAD_PATH. If your downloads or archives live on a
# separate mount, list its absolute root(s) here, colon-separated, to allow
# them. Relative entries are silently ignored. Do not set this to "/": it
# does not disable the check (only the literal path "/" would be allowed);
# list each real mount root instead.
# GDLUXX_CONFIG_PATH_ROOTS=/mnt/media:/mnt/other-drive
