# ===================================================================
# REQUIRED SETTINGS
# ===================================================================

# Authentication secret key (REQUIRED)
# Generate with: openssl rand -hex 32 and paste the result below.
# gdluxx refuses to start in production while this is empty or a placeholder.
AUTH_SECRET=

# Set ORIGIN to the exact address you use to reach gdluxx in your browser,
# including http:// or https:// and the port. If it doesn't match,
# you won't be able to log in.

# Default (use for local dev or testing)
ORIGIN=http://localhost:7755

# Accessing from other devices on your network
# ORIGIN=http://192.168.0.10:7755

# Using your own domain (via Caddy, Nginx, Traefik, etc.)
# ORIGIN=https://gdluxx.my-cool-domain.com

# ===================================================================
# TROUBLESHOOTING
# ===================================================================

# Leave these unset unless login is broken

# Only needed if you can't make ORIGIN match your browser's address.
# Forces login cookies to HTTPS-only (true) or allows plain HTTP
# (false). Setting true on an http:// address will break login.
# USE_SECURE_COOKIES=false

# Only for building from source: if you see "Cross-site POST form
# submissions are forbidden", set this and rebuild. It is baked in at
# build time, so it has no effect on the prebuilt Docker image.
# DISABLE_CSRF_CHECK=true

# ===================================================================
# REVERSE PROXY
# ===================================================================

# Leave UNSET unless gdluxx sits behind a proxy

# gdluxx rate-limits login attempts. By default it trusts NO forwarding header,
# so a directly-exposed instance cannot be tricked by a spoofed/rotated
# X-Forwarded-For into bypassing the limiter: with no trusted header it reads no
# client IP and throttles every login attempt through one shared global bucket,
# fine for a single-user self-host.
#
# Set this ONLY if a reverse proxy (Caddy, Nginx, Traefik, …) sits
# in front of gdluxx and sets a trustworthy client-IP header. Name that header
# here to key the limiter per client IP instead. Do NOT set it on a
# directly-exposed instance, that would re-open the spoofing bypass.
# TRUSTED_PROXY_HEADER=x-forwarded-for

# ===================================================================
# ADVANCED SETTINGS
# You probably don't need to change these!
# Only change these if you need custom configuration
# ===================================================================

# Custom port (default: 7755)
# PORT=7755

# Custom host binding (default: 0.0.0.0 for Docker)
# Use 127.0.0.1 for localhost-only access
# HOST=0.0.0.0

# Custom data directory (default: ./data)
# FILE_STORAGE_PATH=/custom/path/to/data
